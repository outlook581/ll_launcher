<Window x:Class="ll_launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ll_launcher" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" Title="栖点 · Qidian Launcher" FontSize="13" UseLayoutRounding="True" Width="480" Height="624" MinWidth="320" MinHeight="380" WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource BottomBrush}" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" CornerRadius="11" ResizeBorderThickness="4" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <local:IconKeyConverter x:Key="IconKey" />
    <Style x:Key="FavoriteGlyph" TargetType="Path">
      <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Fill" Value="{DynamicResource FavoriteBrush}" /></DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="5" />
    </Style>
    <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="StarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Width" Value="21" />
      <Setter Property="Height" Value="21" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="Opacity" Value="0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
          <Setter Property="Opacity" Value="1" />
        </DataTrigger>
        <Trigger Property="IsKeyboardFocused" Value="True">
          <Setter Property="Opacity" Value="1" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="GridCard">
      <Grid Margin="3" Height="78" ToolTip="{Binding Target, IsAsync=True}" PreviewMouseLeftButtonDown="Item_MouseDown" MouseRightButtonUp="Item_Context">
        <Button Style="{StaticResource CardButton}" Click="Launch_Click" AutomationProperties.Name="{Binding Name}">
          <StackPanel VerticalAlignment="Center">
            <Grid Width="32" Height="32" Margin="0,3,0,7">
              <Path Visibility="{Binding FallbackVisibility}" Data="{Binding FallbackKey, Converter={StaticResource IconKey}}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Margin="2" />
              <Image Source="{Binding Icon}" Stretch="Uniform" />
            </Grid>
            <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
        </Button>
        <Button Style="{StaticResource StarButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="1" Click="Favorite_Click" ToolTip="收藏 / 取消收藏" AutomationProperties.Name="收藏">
          <Path Style="{StaticResource FavoriteGlyph}" Data="{Binding StarKey, Converter={StaticResource IconKey}}" Stretch="Uniform" />
        </Button>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="ListCard">
      <Grid Margin="3,2" Height="44" ToolTip="{Binding Target, IsAsync=True}" PreviewMouseLeftButtonDown="Item_MouseDown" MouseRightButtonUp="Item_Context">
        <Button Style="{StaticResource CardButton}" Click="Launch_Click" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding Name}">
          <Grid Width="{Binding DataContext.RowWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="33" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="19" />
            </Grid.ColumnDefinitions>
            <Grid Width="25" Height="25" HorizontalAlignment="Left">
              <Path Visibility="{Binding FallbackVisibility}" Data="{Binding FallbackKey, Converter={StaticResource IconKey}}" Fill="{DynamicResource AccentBrush}" Stretch="Uniform" />
              <Image Source="{Binding Icon}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding Target, IsAsync=True}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
          </Grid>
        </Button>
        <Button Style="{StaticResource StarButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="7,0" Click="Favorite_Click" ToolTip="收藏 / 取消收藏">
          <Path Style="{StaticResource FavoriteGlyph}" Data="{Binding StarKey, Converter={StaticResource IconKey}}" Stretch="Uniform" />
        </Button>
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="RowTemplate">
      <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{Binding Template}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" Columns="{Binding Columns}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </DataTemplate>
    <Style x:Key="RowsStyle" TargetType="ListBox">
      <Style.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource AppListScrollBar}" />
      </Style.Resources>
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
      <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
      <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
      <Setter Property="ItemTemplate" Value="{StaticResource RowTemplate}" />
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <ContentPresenter />
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{DynamicResource TopColor}" />
        <GradientStop Color="{DynamicResource BottomColor}" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="56" />
        <RowDefinition Height="45" />
        <RowDefinition Height="*" />
        <RowDefinition Height="21" />
      </Grid.RowDefinitions>
      <Grid Margin="15,8,9,3" Background="Transparent" x:Name="TitleBar">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Width="32" Height="32" Source="{StaticResource BrandIcon}" />
          <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="栖点" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{x:Static local:MainWindow.DisplayVersion}" Margin="6,0,0,2" VerticalAlignment="Bottom" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
            <TextBlock Text="QIDIAN LAUNCHER" FontSize="8" Foreground="{DynamicResource MutedBrush}" Margin="1,1,0,0" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="PinButton" Style="{StaticResource TitleBarButton}" Click="Pin_Click" ToolTip="固定位置并保持展开">
            <Path x:Name="PinGlyph" Data="{StaticResource Icon.pin}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" />
          </Button>
          <Button x:Name="MoreButton" Style="{StaticResource TitleBarButton}" Click="More_Click" ToolTip="更多操作" AutomationProperties.Name="更多操作">
            <Path Data="{StaticResource Icon.more}" Fill="{DynamicResource TextBrush}" Stretch="Uniform" />
          </Button>
          <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click" ToolTip="最小化">
            <Path Data="{StaticResource Icon.minimize}" Fill="{DynamicResource TextBrush}" Stretch="Uniform" />
          </Button>
          <Button Style="{StaticResource TitleBarButton}" Click="Close_Click" ToolTip="隐藏到托盘">
            <Path Data="{StaticResource Icon.close}" Fill="{DynamicResource TextBrush}" Stretch="Uniform" />
          </Button>
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" Margin="15,2,15,9" CornerRadius="7" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="27" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Path Data="{StaticResource Icon.search}" Fill="{DynamicResource TextBrush}" Width="13" Height="13" Stretch="Uniform" />
          <Grid Grid.Column="1">
            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="搜索应用、文件或网址" />
            <TextBlock x:Name="SearchHint" Text="搜索应用、文件或网址…" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Margin="5" Padding="5,1" ToolTip="回车打开第一项">
              <TextBlock Text="↵ 打开" FontSize="10" VerticalAlignment="Center" />
            </Border>
            <Button Style="{StaticResource IconButton}" Width="24" Height="24" Margin="0,0,3,0" Click="ClearSearch_Click" ToolTip="清空搜索" AutomationProperties.Name="清空搜索">
              <Path Data="{StaticResource Icon.close}" Fill="{DynamicResource MutedBrush}" Width="12" Height="12" Stretch="Uniform" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="108" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,1,0" Background="{DynamicResource SidebarBrush}">
          <DockPanel Margin="7,7,7,0">
            <StackPanel x:Name="SidebarActions" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="1,5,0,5">
              <Button Style="{StaticResource IconButton}" Click="AddGroup_Click" ToolTip="新建分组" Background="{DynamicResource RaisedBrush}">
                <Path Data="{StaticResource Icon.add}" Fill="{DynamicResource TextBrush}" Stretch="Uniform" />
              </Button>
              <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Click="Collapse_Click" ToolTip="收起 / 展开分组名称" AutomationProperties.Name="收起或展开分组名称" Margin="5,0,0,0">
                <Path Data="{StaticResource Icon.sidebar}" Fill="{DynamicResource TextBrush}" Stretch="Uniform" />
              </Button>
            </StackPanel>
            <ListBox x:Name="GroupList" PreviewMouseLeftButtonDown="Group_MouseDown" AllowDrop="True" PreviewDragEnter="List_DragOver" PreviewDragOver="List_DragOver" PreviewDrop="List_Drop" PreviewDragLeave="List_DragLeave" Background="Transparent" BorderThickness="0" SelectionChanged="Group_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="Margin" Value="0,2" />
                  <Setter Property="Padding" Value="8,8" />
                  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <Setter.Value>
                      <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                          <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource HoverBrush}" />
                          </Trigger>
                          <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Setter.Value>
                  </Setter>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ToolTip="{Binding Name}" MouseRightButtonUp="Group_Context">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="15" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Data="{Binding IconKey, Converter={StaticResource IconKey}}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Width="14" Height="14" Stretch="Uniform" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="8,0,0,0" FontSize="13" VerticalAlignment="Center" Visibility="{Binding LabelVisibility}" TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1" x:Name="ContentArea" Margin="11,0,10,0" SizeChanged="Content_SizeChanged">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="37" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel x:Name="FavoritesPanel" Margin="0,4,0,6">
            <StackPanel Orientation="Horizontal" Margin="4,6,0,8">
              <TextBlock Text="常用" FontSize="14" FontWeight="SemiBold" />
              <Path Data="{StaticResource Icon.starFilled}" Fill="{DynamicResource FavoriteBrush}" Width="12" Height="12" Stretch="Uniform" Margin="6,0,0,0" />
            </StackPanel>
            <ListBox x:Name="FavoritesList" Style="{StaticResource RowsStyle}" MaxHeight="168" />
            <TextBlock x:Name="FavoritesEmpty" Text="将鼠标移到应用上，点亮星标即可收藏" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="5,3,5,9" FontSize="11" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="3,0,3,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="SectionTitle" Text="全部应用" FontSize="14" FontWeight="SemiBold" />
              <TextBlock x:Name="ItemCount" Foreground="{DynamicResource MutedBrush}" Margin="5,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button x:Name="GridModeButton" Style="{StaticResource IconButton}" Click="GridMode_Click" ToolTip="图标视图">
                <Path Data="{StaticResource Icon.grid}" Fill="{DynamicResource TextBrush}" Stretch="Uniform" />
              </Button>
              <Button x:Name="ListModeButton" Style="{StaticResource IconButton}" Click="ListMode_Click" ToolTip="列表视图">
                <Path Data="{StaticResource Icon.list}" Fill="{DynamicResource TextBrush}" Stretch="Uniform" />
              </Button>
            </StackPanel>
          </Grid>
          <Grid Grid.Row="2">
            <ListBox x:Name="MainItems" AllowDrop="True" PreviewDragEnter="List_DragOver" PreviewDragOver="List_DragOver" PreviewDrop="List_Drop" PreviewDragLeave="List_DragLeave" Style="{StaticResource RowsStyle}" />
            <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" Margin="13">
              <Path Data="{StaticResource Icon.add}" Fill="{DynamicResource MutedBrush}" Width="24" Height="24" Stretch="Uniform" />
              <TextBlock x:Name="EmptyTitle" Text="把常用的东西，放在这里" TextAlignment="Center" Margin="0,10,0,5" FontSize="12" />
              <TextBlock Text="拖入程序、快捷方式、文件或文件夹&#xA;也可以右上角添加网址" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
              <Button Content="添加启动项" HorizontalAlignment="Center" Padding="16,7" Style="{StaticResource SoftButton}" Click="AddItem_Click" Background="{DynamicResource SelectedBrush}" Margin="10,12" />
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
      <TextBlock Grid.Row="3" x:Name="StatusText" Text="拖入文件即可添加 · 右键管理" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="15,3,15,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Grid>
  </Border>
</Window>
