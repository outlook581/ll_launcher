<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\qidian-framework-dependent\</PublishDir>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Licenses\Apache-2.0.txt;Licenses\Microsoft.Data.Sqlite-LICENSE.txt;Licenses\SQLite-NOTICES.txt"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The root apphost loads the application from Runtime using the installed .NET desktop runtime. -->
  <Target Name="LayoutPortableFiles" AfterTargets="ComputeFilesToPublish" DependsOnTargets="_GetAppHostPaths">
    <PropertyGroup>
      <PortableHost>$(IntermediateOutputPath)portable\$(AssemblyName).exe</PortableHost>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)portable" />
    <CreateAppHost AppHostSourcePath="$(AppHostSourcePath)" AppHostDestinationPath="$(PortableHost)"
                   AppBinaryName="Runtime/$(AssemblyName).dll" IntermediateAssembly="@(IntermediateAssembly->'%(FullPath)')"
                   WindowsGraphicalUserInterface="true" />
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' == '$(AssemblyName).exe'" />
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="!$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('/','\').StartsWith('Assets\'))">
        <RelativePath>Runtime\%(ResolvedFileToPublish.RelativePath)</RelativePath>
      </ResolvedFileToPublish>
      <ResolvedFileToPublish Include="$(PortableHost)" RelativePath="$(AssemblyName).exe" CopyToPublishDirectory="Always" />
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\README.md" RelativePath="README.md" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\LICENSE" RelativePath="LICENSE" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)\..\NOTICE" RelativePath="NOTICE" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
