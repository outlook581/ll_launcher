<Window x:Class="ll_launcher.EditDialog" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ll_launcher"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}" FontSize="12" Background="{DynamicResource TopBrush}" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" SizeToContent="Height" ShowInTaskbar="False"
        UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="9" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <local:IconKeyConverter x:Key="GroupIcon" />
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Outline" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="GroupChoice" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="MaxDropDownHeight" Value="180" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Field" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Data="M 0,0 L 4,4 8,0" Stroke="{DynamicResource MutedBrush}" />
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <TextBlock IsHitTestVisible="False" Margin="9,0,24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Text="{Binding SelectedItem.Value, RelativeSource={RelativeSource TemplatedParent}}" />
              <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="3"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Row" Background="Transparent" CornerRadius="4" Padding="7,4"><TextBlock Text="{Binding Value}" /></Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectedBrush}" /></Trigger>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border CornerRadius="8" BorderThickness="1" Background="{DynamicResource TopBrush}" BorderBrush="{DynamicResource BorderBrush}" Padding="14,8,14,12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="×" IsCancel="True" Style="{StaticResource SoftButton}" Padding="0" Width="25" Height="24"
                shell:WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="关闭" ToolTip="关闭" />
        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource AppListScrollBar}" /></ScrollViewer.Resources>
        <StackPanel Margin="0,2,1,0">
          <StackPanel x:Name="Fields" />
          <StackPanel x:Name="IconPanel" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Margin="0,9,0,4">
              <TextBlock Text="图标" Foreground="{DynamicResource MutedBrush}" /><TextBlock Text="{Binding SelectedItem.Value, ElementName=IconChoices}" Foreground="{DynamicResource MutedBrush}" Margin="8,0,0,0" />
            </StackPanel>
            <ListBox x:Name="IconChoices" SelectedValuePath="Key" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="分组图标">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="AutomationProperties.Name" Value="{Binding Value}" /><Setter Property="ToolTip" Value="{Binding Value}" />
                  <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Tile" Background="{DynamicResource SurfaceBrush}" Margin="2" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Height="28">
                        <Path Width="16" Height="16" Fill="{DynamicResource TextBrush}" Stretch="Uniform" Data="{Binding Key, Converter={StaticResource GroupIcon}}" />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource SelectedBrush}" /><Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value></Setter>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
          </StackPanel>
          <Expander x:Name="Advanced" Header="启动参数与工作目录" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed" Margin="0,10,0,0">
            <Expander.Template>
              <ControlTemplate TargetType="Expander">
                <StackPanel>
                  <ToggleButton x:Name="Disclosure" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Content="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Left">
                    <ToggleButton.Template>
                      <ControlTemplate TargetType="ToggleButton">
                        <StackPanel Background="Transparent" Orientation="Horizontal">
                          <Path x:Name="Chevron" Data="M 0,0 L 3.5,3.5 0,7" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.3"
                                VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Margin="3,0,8,0" />
                          <ContentPresenter />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90" /></Setter.Value></Setter></Trigger>
                          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ToggleButton.Template>
                  </ToggleButton>
                  <ContentPresenter x:Name="Details" Visibility="Collapsed" />
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Details" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
              </ControlTemplate>
            </Expander.Template>
            <StackPanel x:Name="AdvancedFields" />
          </Expander>
          <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,7,0,0" />
        </StackPanel>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="取消" IsCancel="True" Style="{StaticResource SoftButton}" Background="{DynamicResource RaisedBrush}" Padding="13,5" />
        <Button Content="保存" IsDefault="True" Style="{StaticResource SoftButton}" Background="{DynamicResource SelectedBrush}" Padding="13,5" Margin="7,0,0,0" Click="Save_Click" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
